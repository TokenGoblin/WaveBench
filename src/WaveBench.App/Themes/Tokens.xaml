<!--
    The plan §8.1 token set. THIS IS THE ONLY FILE IN THE APPLICATION
    ALLOWED TO CONTAIN A COLOUR LITERAL — XamlTokenTests greps every other
    XAML file to enforce it, which is what makes light/dark themeing and the
    accessibility pass possible at all.

    Look: "UniFi-like" — calm, flat, spacious, card-based, one strong blue
    accent, generous whitespace, restrained motion. Built from these values;
    no vendor assets, logos or icons are copied.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ Light theme ============ -->
    <Color x:Key="Light.Canvas">#F7F8F9</Color>
    <Color x:Key="Light.Surface">#FFFFFF</Color>
    <Color x:Key="Light.SurfaceAlt">#F2F4F5</Color>
    <Color x:Key="Light.BorderSubtle">#12000000</Color>
    <Color x:Key="Light.BorderStrong">#DCE0E4</Color>
    <Color x:Key="Light.TextPrimary">#1A1D21</Color>
    <Color x:Key="Light.TextSecondary">#7C8593</Color>
    <Color x:Key="Light.TextDisabled">#B4BBC4</Color>

    <!-- ============ Dark theme ============ -->
    <Color x:Key="Dark.Canvas">#16181A</Color>
    <Color x:Key="Dark.Surface">#1E2124</Color>
    <Color x:Key="Dark.Elevated">#24282C</Color>
    <Color x:Key="Dark.BorderSubtle">#14FFFFFF</Color>
    <Color x:Key="Dark.TextPrimary">#F2F4F5</Color>
    <Color x:Key="Dark.TextSecondary">#98A1AC</Color>

    <!-- ============ Accent and semantics (both themes) ============ -->
    <Color x:Key="Accent.Primary">#006FFF</Color>
    <Color x:Key="Accent.Hover">#0559C9</Color>
    <Color x:Key="Accent.Subtle">#1A006FFF</Color>
    <Color x:Key="Accent.Success">#00A657</Color>
    <Color x:Key="Accent.Warning">#F5A623</Color>
    <Color x:Key="Accent.Danger">#F03A3E</Color>
    <Color x:Key="Accent.Info">#7B61FF</Color>

    <!-- ============ Active brushes — rebound by ThemeManager ============ -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Light.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Light.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Light.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Light.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Light.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Light.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Light.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Light.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Accent.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Accent.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Accent.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Accent.Info}" />

    <!-- Foreground for content sitting ON the accent fill. A token, not a
         literal "White", so changing the accent to a light colour does not
         leave unreadable text behind. -->
    <Color x:Key="Accent.OnAccent">#FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Accent.OnAccent}" />

    <!-- Interaction ink. Semi-transparent overlays rather than replacement
         fills, so one pair of tokens gives hover and pressed feedback on a
         surface button, an accent button and a transparent rail item alike.
         Swapping the fill instead would need a variant per button colour, and
         the one that got forgotten would be the one that looked dead. -->
    <Color x:Key="Light.OverlayHover">#0F000000</Color>
    <Color x:Key="Light.OverlayPressed">#26000000</Color>
    <Color x:Key="Dark.OverlayHover">#18FFFFFF</Color>
    <Color x:Key="Dark.OverlayPressed">#33FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.OverlayHover" Color="{StaticResource Light.OverlayHover}" />
    <SolidColorBrush x:Key="Brush.OverlayPressed" Color="{StaticResource Light.OverlayPressed}" />

    <!-- ============ Radius · spacing · motion · type (§8.1) ============ -->
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Input">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Thickness x:Key="Space.CardPadding">20</Thickness>
    <Thickness x:Key="Space.SectionGap">0,0,0,24</Thickness>
    <sys:Double x:Key="Space.TableRow">32</sys:Double>

    <Duration x:Key="Motion.Fast">0:0:0.15</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.20</Duration>

    <FontFamily x:Key="Type.Family">Lato, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Type.Mono">Cascadia Mono, Consolas, monospace</FontFamily>
    <sys:Double x:Key="Type.Caption">12</sys:Double>
    <sys:Double x:Key="Type.Small">13</sys:Double>
    <sys:Double x:Key="Type.Body">14</sys:Double>
    <sys:Double x:Key="Type.Subtitle">16</sys:Double>
    <sys:Double x:Key="Type.Title">20</sys:Double>
    <sys:Double x:Key="Type.Large">24</sys:Double>
    <sys:Double x:Key="Type.Display">32</sys:Double>

    <!-- ============ Base styles ============ -->

    <!--
        Buttons. IMPLICIT (no x:Key) on purpose: every button in this app is
        built in code, and a keyed style is a style somebody forgets to apply.

        This exists because the app previously had no button style at all. The
        workspace rail carried its own inline template with no triggers in it,
        so the primary navigation gave no hover and no pressed feedback
        whatsoever, and every other button was left to whatever the platform
        default happened to be — which is a pale blue Aero wash that neither
        matches this design nor reads as a press on a light surface. A user
        clicking around found the whole thing unresponsive, and they were right
        to: nothing acknowledged the click.

        The feedback is an ink overlay above the fill rather than a replacement
        fill, so it works on any background the caller sets.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6,12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Type.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Input}" />
                        <Border x:Name="Ink"
                                CornerRadius="{StaticResource Radius.Input}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ink" Property="Background"
                                    Value="{DynamicResource Brush.OverlayHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ink" Property="Background"
                                    Value="{DynamicResource Brush.OverlayPressed}" />
                        </Trigger>
                        <!-- Keyboard focus has to be visible too: §8.1 asks for
                             an accessibility pass, and a mouse-only affordance
                             fails it. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Space.CardPadding}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Type.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Type.Small}" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Type.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Numeric readouts use tabular figures so columns align (§8.1). -->
    <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource Type.Large}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

</ResourceDictionary>
